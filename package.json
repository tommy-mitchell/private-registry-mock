{
	"name": "private-registry-mock",
	"version": "0.3.0",
	"description": "Simple mocked server and package of an npm private registry.",
	"license": "MIT",
	"repository": "tommy-mitchell/private-registry-mock",
	"author": "Tommy Mitchell (https://tommymitchell.io)",
	"type": "module",
	"exports": {
		"types": "./dist/index.d.ts",
		"default": "./dist/index.js"
	},
	"imports": {
		"#src/*.ts": "./src/*.ts"
	},
	"sideEffects": false,
	"engines": {
		"node": "^22.22 || ^24.15 || >=26"
	},
	"scripts": {
		"prepare": "npm run build",
		"build": "tsdown",
		"lint": "dprint check && xo",
		"format": "dprint fmt && xo --fix",
		"test": "c8 ava && tsd test-d"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"nodejs",
		"npm",
		"registry",
		"mock",
		"private",
		"server",
		"package",
		"pkg",
		"package.json",
		"json",
		"module",
		"scope",
		"scoped"
	],
	"dependencies": {
		"basic-auth": "^3.0.0",
		"get-port": "^7.2.0",
		"lil-http-terminator": "^1.2.3",
		"polka": "^1.0.0-next.28",
		"polka-bearer-token": "^1.0.0"
	},
	"devDependencies": {
		"@tommy-mitchell/configs": "^0.2.1",
		"@types/basic-auth": "^1.1.8",
		"@types/node": "^22",
		"ava": "^8.0.1",
		"c8": "^12.0.0",
		"dprint": "^0.61.1",
		"ky": "^2.1.0",
		"package-json": "^10.0.1",
		"tsd": "^0.33.0",
		"tsdown": "^0.23.0",
		"type-fest": "^5.10.0",
		"typescript": "~6.0.3",
		"xo": "^5.0.1"
	},
	"ava": {
		"extensions": [
			"ts"
		],
		"concurrency": 1
	}
}
